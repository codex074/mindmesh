#!/usr/bin/env python3
"""MindMesh one-command local launcher.

After ``git clone``, a user runs ``./mindmesh`` (or ``mindmesh`` once it is on
PATH) and everything is bootstrapped automatically:

  1. finds — or provisions — a Python >= 3.11;
  2. creates a project-local virtualenv (``.venv``);
  3. installs the package and its dependencies inside it (idempotent);
  4. creates a local ``.env`` from ``.env.example`` on first run;
  5. uses port 8000 when available (or picks a free port automatically),
     then starts the server bound to 127.0.0.1;
  6. opens the browser once the health check passes.

Quick analysis + market data need no API key and no extra install. The
"Deep" (TradingAgents) mode is opt-in via ``mindmesh --deep``.
"""

from __future__ import annotations

import hashlib
import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

# Bump Python when this script starts using newer features: we allow the host
# interpreter to be as old as 3.8 while it searches for a 3.11+ to hand off to.
if sys.version_info < (3, 11):
    for name in ("python3.13", "python3.12", "python3.11"):
        candidate = shutil.which(name)
        if candidate:
            os.execv(candidate, [candidate] + sys.argv)
    # No qualifying python on PATH: fall through and let main() try
    # uv / Homebrew, or print a clear error.

ROOT = Path(__file__).resolve().parent
VENV = ROOT / ".venv"
VENV_PY = VENV / "bin" / "python"
STAMP = VENV / ".mindmesh-stamp"
ENV_FILE = ROOT / ".env"
PORT_FILE = ROOT / ".mindmesh-port"
DEVNULL = subprocess.DEVNULL
DEFAULT_PORT = 8000


def log(msg: str) -> None:
    print(f"[mindmesh] {msg}", flush=True)


def fail(msg: str) -> None:
    print(f"[mindmesh] ERROR: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def version_ok(exe: str) -> bool:
    code = "import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)"
    try:
        return subprocess.call([exe, "-c", code], stdout=DEVNULL, stderr=DEVNULL) == 0
    except OSError:
        return False


def find_python():
    for name in ("python3.13", "python3.12", "python3.11", "python3", "python"):
        exe = shutil.which(name)
        if exe and version_ok(exe):
            return exe
    return None


def provision_python():
    """Try Homebrew, then uv, to get a Python >= 3.11. Returns an exe or None."""
    brew = shutil.which("brew")
    if brew:
        for formula in ("python@3.13", "python@3.12", "python@3.11"):
            log(f"Python >= 3.11 not found — installing {formula} with Homebrew…")
            if subprocess.call([brew, "install", formula]) == 0:
                found = find_python()
                if found:
                    return found
    return None


def ensure_venv(py) -> None:
    if VENV_PY.exists() and version_ok(str(VENV_PY)):
        return
    if VENV.exists():
        shutil.rmtree(VENV)
    uv = shutil.which("uv")
    if uv:
        log("creating virtualenv with uv…")
        if subprocess.call([uv, "venv", "--python", "3.11", str(VENV)]) != 0:
            fail("could not create the virtualenv with uv")
    elif py:
        log("creating virtualenv…")
        if subprocess.call([py, "-m", "venv", str(VENV)]) != 0:
            fail("could not create the virtualenv")
    else:
        fail("Python 3.11+ or uv is required to create the virtualenv")
    if not VENV_PY.exists() or not version_ok(str(VENV_PY)):
        fail("the virtualenv does not contain a Python >= 3.11")


def current_stamp(deep: bool) -> str:
    h = hashlib.sha256()
    h.update((ROOT / "pyproject.toml").read_bytes())
    h.update(b"deep" if deep else b"quick")
    return h.hexdigest()


def ensure_installed(deep: bool, py) -> None:
    stamp = current_stamp(deep)
    if STAMP.exists() and STAMP.read_text().strip() == stamp:
        return
    target = ".[deep]" if deep else "."
    uv = shutil.which("uv")
    if uv:
        cmd = [uv, "pip", "install", "--python", str(VENV_PY), "-e", target]
    else:
        cmd = [str(VENV_PY), "-m", "pip", "install", "-e", target]
    extra = " (with Deep/TradingAgents)" if deep else ""
    log(f"installing dependencies{extra} — first run only…")
    if subprocess.call(cmd, cwd=str(ROOT)) != 0:
        fail("dependency installation failed; run the command again to retry")
    STAMP.write_text(stamp)


def ensure_env() -> None:
    if ENV_FILE.exists():
        return
    example = ROOT / ".env.example"
    if not example.exists():
        return
    overrides = {
        "APP_ENV": "development",
        "APP_HOST": "127.0.0.1",
        "APP_PORT": "8000",
        "APP_PUBLIC_URL": "http://127.0.0.1:8000",
        "APP_DATA_DIR": "./data",
    }
    lines: list[str] = []
    for line in example.read_text().splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            lines.append(line)
            continue
        key = stripped.split("=", 1)[0].strip()
        lines.append(f"{key}={overrides[key]}" if key in overrides else line)
    ENV_FILE.write_text("\n".join(lines) + "\n")
    log("created .env with local development defaults")


def load_env() -> None:
    if not ENV_FILE.exists():
        return
    for line in ENV_FILE.read_text().splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, value = stripped.split("=", 1)
        os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))


def is_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False


def pick_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def resolve_port() -> int:
    wanted = os.environ.get("MINDMESH_PORT")
    requested_port = _valid_port(wanted)
    if wanted and requested_port is None:
        log(f"ignoring invalid MINDMESH_PORT={wanted!r}")

    if requested_port is not None and is_free(requested_port):
        port = requested_port
    else:
        if requested_port is not None:
            log(f"requested port {requested_port} is busy — choosing another port")

        # The predictable default is part of the launcher interface. A
        # remembered fallback must never keep us away from 8000 once it is
        # available again.
        if is_free(DEFAULT_PORT):
            port = DEFAULT_PORT
        else:
            remembered_port = _read_remembered_port()
            if (
                remembered_port is not None
                and remembered_port != DEFAULT_PORT
                and is_free(remembered_port)
            ):
                port = remembered_port
            else:
                port = pick_port()
            log(f"port {DEFAULT_PORT} is busy — using port {port}")

    PORT_FILE.write_text(str(port))
    return port


def _valid_port(raw: str | None) -> int | None:
    if raw is None:
        return None
    try:
        port = int(raw.strip())
    except ValueError:
        return None
    return port if 1 <= port <= 65535 else None


def _read_remembered_port() -> int | None:
    if not PORT_FILE.exists():
        return None
    try:
        return _valid_port(PORT_FILE.read_text().strip())
    except OSError:
        return None


def wait_until_ready(url: str, timeout: float = 30.0) -> bool:
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=1) as resp:
                if resp.status == 200:
                    return True
        except Exception:
            pass
        time.sleep(0.3)
    return False


def open_browser(url: str) -> None:
    for opener in ("open", "xdg-open"):
        exe = shutil.which(opener)
        if exe:
            subprocess.Popen([exe, url], stdout=DEVNULL, stderr=DEVNULL)
            return
    log(f"open {url} in your browser")


def main() -> int:
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print("usage: mindmesh [--deep]")
        print("  --deep   also install the TradingAgents extra for Deep analysis mode")
        return 0
    deep = "--deep" in args

    os.chdir(str(ROOT))

    py = find_python()
    if py is None:
        if shutil.which("uv") is None:
            py = provision_python()
    if py is None and shutil.which("uv") is None:
        fail(
            "Python 3.11+ is required. Install it (e.g. `brew install python@3.11`) "
            "or install uv (https://docs.astral.sh/uv) and re-run."
        )

    ensure_venv(py)
    ensure_installed(deep, py)
    ensure_env()
    load_env()

    port = resolve_port()
    # Local-dev overrides: loopback only, dev env, auto port. The launcher owns
    # these so a user's production .env never leaks into a local run.
    os.environ["APP_ENV"] = "development"
    os.environ["APP_HOST"] = "127.0.0.1"
    os.environ["APP_PORT"] = str(port)
    os.environ["APP_PUBLIC_URL"] = f"http://127.0.0.1:{port}"
    os.environ["APP_DATA_DIR"] = str(ROOT / "data")

    url = f"http://127.0.0.1:{port}"
    log("starting MindMesh…")
    log(f"  → {url}")
    log("  (press Ctrl+C to stop)")

    proc = subprocess.Popen(
        [str(VENV_PY), "-c", "from app.main import run; run()"],
        cwd=str(ROOT),
    )

    try:
        if wait_until_ready(url + "/health/live"):
            log("server ready — opening browser")
            open_browser(url)
        else:
            log("server did not report ready within 30s (logs are above)")

        # Parent and child share the terminal's foreground process group, so
        # Ctrl+C reaches uvicorn too; we just wait until it exits.
        while proc.poll() is None:
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()

    return proc.poll() if proc.poll() is not None else 0


if __name__ == "__main__":
    sys.exit(main())
