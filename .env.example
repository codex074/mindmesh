# Server-side configuration template (PRODUCT_PLAN.md §12).
#
# NEVER put a BYOK provider API key here. Keys arrive per-request from end users
# only (§12). Deep-mode memory logs live under APP_DATA_DIR (see F3 constraint).

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=https://stocks.example.com
APP_ALLOWED_HOSTS=stocks.example.com

APP_MARKET_PROVIDER=yfinance
APP_MARKET_CACHE_TTL_SECONDS=120
APP_MARKET_TV_DEFAULT_EXCHANGE=NASDAQ
APP_MARKET_TV_DEFAULT_SCREENER=america
APP_MARKET_TV_TIMEOUT_SECONDS=10
APP_MARKET_TV_CACHE_TTL_SECONDS=120

# TradingView Desktop bridge — LOCAL-ONLY, disabled by default. Requires the
# `desktop` extra (`pip install -e ".[desktop]"`), Node.js, TradingView
# Desktop open on THIS host, and the tradingview-mcp server checked out
# locally. Cannot run on a VPS. See docs/TRADINGVIEW_INTEGRATION_PLAN.md.
APP_MARKET_TV_DESKTOP_ENABLED=false
APP_MARKET_TV_DESKTOP_SERVER_PATH=
APP_MARKET_TV_DESKTOP_TIMEOUT_SECONDS=20

APP_AI_MAX_OUTPUT_TOKENS=2000
APP_AI_TIMEOUT_SECONDS=90
APP_AI_FIRST_TOKEN_TIMEOUT_SECONDS=30
APP_AI_ALLOWED_BASE_URLS=
APP_AI_MAX_CONCURRENT_PER_CLIENT=3

# proxy = reverse proxy (Caddy) hands us an authenticated identity header.
APP_AUTH_MODE=proxy

# Deep-mode (TradingAgents) subprocess pool sizing (EXECUTION_PLAN.md D4/D5).
APP_DATA_DIR=/app/data
APP_DEEP_MAX_CONCURRENT_JOBS=3
APP_DEEP_RUNNER_TIMEOUT_SECONDS=900

LOG_LEVEL=INFO